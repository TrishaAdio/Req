[Unit]
Description=Join-request welcome + broadcast bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gatecast
ExecStart=/opt/gatecast/.venv/bin/python bot.py
Restart=always
RestartSec=5
# journald keeps the log; colours are off automatically when not a terminal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
