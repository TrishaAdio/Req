# ===========================================================================
# Telegram API credentials — https://my.telegram.org  ->  API development tools
# Telethon needs these even for a bot login.
# ===========================================================================
API_ID=1234567
API_HASH=your_api_hash_here

# Token from @BotFather. The bot must be an ADMIN with the "Add users" right in
# every channel it serves, and those channels need "Approve new members" on.
BOT_TOKEN=123456:ABC-DEF_your_bot_token

# ===========================================================================
# Who may command the bot. Your numeric user id (@userinfobot knows it).
# Start the bot without it, message the bot, and the log prints your id.
# ADMIN_IDS adds co-owners: ADMIN_IDS=111111111,222222222
# ===========================================================================
OWNER_ID=123456789
ADMIN_IDS=

# ===========================================================================
# Channels are added at runtime:  /add -1001234567890   /remove ...   /chats
# true  -> serve nothing until a channel is added (default)
# false -> while no channel is added, serve EVERY chat the bot administers,
#          so anyone who makes it an admin feeds your audience
# ===========================================================================
STRICT_CHANNELS=true

# false -> every join request gets the post, so someone who was welcomed
#          before is welcomed again when they request another channel or
#          re-request the same one (default)
# true  -> one post per user, ever; later requests from them send nothing
WELCOME_ONCE=false
# Parallel welcome sends during a join raid.
WELCOME_CONCURRENCY=5

# ===========================================================================
# Broadcast pacing. Roughly BROADCAST_WORKERS / SEND_DELAY_SECONDS per second,
# so the defaults are ~1/s (~3.5k/hour with the batch pauses).
# These are DMs to people who never started the bot, which is the traffic
# Telegram limits hardest. Raising this raises the odds of PeerFlood, which
# stops a run; there is no safe number, only your own risk.
# MAX_FLOOD_WAIT: a flood wait longer than this stops the run instead of
# waiting it out.
# ===========================================================================
BROADCAST_WORKERS=1
SEND_DELAY_SECONDS=1.0
BATCH_SIZE=50
BATCH_PAUSE_SECONDS=30
MAX_FLOOD_WAIT=300
PROGRESS_EVERY_SECONDS=6

# ===========================================================================
# Logging / storage
# ===========================================================================
LOG_LEVEL=INFO
# LOG_FILE=bot.log
# DATA_DIR=/var/lib/req
